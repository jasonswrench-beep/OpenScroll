# Local development only. Production credentials must be configured separately.
DATABASE_URL=postgresql://openscroll_app:openscroll_runtime_local_dev_password_9876543210@127.0.0.1:5432/openscroll
# These privileged settings are for trusted provisioning/migration tools only.
# npm start/dev strip them before launching the runtime process.
ADMIN_DATABASE_URL=postgresql://openscroll_migrator:openscroll_migrator_local_dev_password_0123456789@127.0.0.1:5432/openscroll
PROVISION_DATABASE_URL=postgresql://openscroll:openscroll_dev@127.0.0.1:5432/openscroll
MIGRATOR_DB_PASSWORD=openscroll_migrator_local_dev_password_0123456789
RUNTIME_DB_PASSWORD=openscroll_runtime_local_dev_password_9876543210
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
REGISTRATION_ENABLED=true
# Request access creates a pending account; only this instance's owner can approve it.
# Optional notification recipient, separate from the owner login and SMTP credentials.
ACCESS_REQUEST_NOTIFY_EMAIL=
REQUIRE_EMAIL_VERIFICATION=true
# Local development emails contain private reset/verification links.
MAIL_MODE=outbox
MAIL_OUTBOX_DIR=.local/mail
# Production: HTTPS origin, SMTP, and verification; never commit credentials.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=465
# MAIL_FROM=OpenScroll <no-reply@example.org>
# SMTP_USER=
# SMTP_PASSWORD=

# Active stored course assets per author; separate from reusable/snapshot quota.
AUTHOR_ASSET_LIMIT_MIB=1024
# Set 1 only behind one trusted reverse proxy with a private application port.
TRUST_PROXY=false

# Start the separate isolated renderer and source its generated .local/renderer-test.env.
# PDF_RENDERER_SOCKET=/absolute/path/to/private/renderer.sock
