{
  "name": "openscroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx tools/dev.ts",
    "build": "tsc --noEmit && vite build && tsx tools/player-notices.ts && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env tools/start-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "test:browser": "playwright test",
    "licenses": "tsx tools/check-licenses.ts",
    "project": "tsx tools/project.ts",
    "schema": "tsx tools/schema.ts",
    "schema:check": "tsx tools/schema.ts --check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/migrate.ts",
    "db:provision": "node --env-file-if-exists=.env --import tsx src/server/provision.ts --from-env"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.10",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "playwright-core": "1.64.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
