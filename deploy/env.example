# Copy to .env.production with mode 600. No actual credentials belong in Git.
# Keep the generated database password as URL-safe hex (do not change after initialization).
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
OPENSCROLL_IMAGE=openscroll:production
OPENSCROLL_HOST=openscroll.example.org
APP_ORIGIN=https://openscroll.example.org
APP_PORT=3100
ACME_EMAIL=operator@example.org
REGISTRATION_ENABLED=false
AUTHOR_ASSET_LIMIT_MIB=1024
MAIL_FROM=OpenScroll <no-reply@example.org>
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
