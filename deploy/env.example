# Copy to .env.production with mode 600. No actual credentials belong in Git.
# Keep the generated database password as URL-safe hex (do not change after initialization).
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# New independent login passwords; never give bootstrap/migration credentials to the app.
MIGRATOR_DB_PASSWORD=REPLACE_WITH_MIGRATOR_64_HEX
RUNTIME_DB_PASSWORD=REPLACE_WITH_RUNTIME_64_HEX
OPENSCROLL_IMAGE=openscroll:production
OPENSCROLL_HOST=openscroll.example.org
APP_ORIGIN=https://openscroll.example.org
APP_PORT=3100
ACME_EMAIL=operator@example.org
REGISTRATION_ENABLED=false
# Set true to accept access requests. Verification and owner approval are still required.
# Notifications use the existing SMTP transport; this is a recipient, not an SMTP login.
ACCESS_REQUEST_NOTIFY_EMAIL=
AUTHOR_ASSET_LIMIT_MIB=1024
MAIL_FROM=OpenScroll <no-reply@example.org>
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Separate credential-free PDF worker image, built with Docker target renderer.
OPENSCROLL_RENDERER_IMAGE=openscroll:renderer
